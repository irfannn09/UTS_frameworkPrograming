digraph ERD {
  graph [rankdir=LR, fontname="DejaVu Sans", labelloc=t, fontsize=20, label="ERD - Gym Management System", pad=0.4, nodesep=0.6, ranksep=1.3, splines=spline, newrank=true];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#444444", arrowhead=none, arrowtail=none];

  members [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#2f5d8a" COLSPAN="3"><FONT COLOR="white"><B>members</B></FONT></TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">varchar(100)</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(100)</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">phone_number</TD><TD ALIGN="LEFT">varchar(20)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">date_of_birth</TD><TD ALIGN="LEFT">date, null</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">text, null</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>>];

  membership_plans [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#2f5d8a" COLSPAN="3"><FONT COLOR="white"><B>membership_plans</B></FONT></TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text, null</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">duration_in_days</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">decimal(12,2)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>>];

  memberships [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#2f7d5a" COLSPAN="3"><FONT COLOR="white"><B>memberships</B></FONT></TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT" PORT="member_id">member_id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT" PORT="plan_id">membership_plan_id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">start_date</TD><TD ALIGN="LEFT">date</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">end_date</TD><TD ALIGN="LEFT">date</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>>];

  trainers [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#2f5d8a" COLSPAN="3"><FONT COLOR="white"><B>trainers</B></FONT></TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">varchar(100)</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(100)</TD></TR>
      <TR><TD>UQ</TD><TD ALIGN="LEFT">phone_number</TD><TD ALIGN="LEFT">varchar(20)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">specialization</TD><TD ALIGN="LEFT">varchar(100)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>>];

  training_sessions [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#2f7d5a" COLSPAN="3"><FONT COLOR="white"><B>training_sessions</B></FONT></TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD>FK</TD><TD ALIGN="LEFT" PORT="trainer_id">trainer_id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">varchar(100)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text, null</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">start_time</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">end_time</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">capacity</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>>];

  session_participants [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#8a5d2f" COLSPAN="3"><FONT COLOR="white"><B>session_participants</B></FONT></TD></TR>
      <TR><TD>PK</TD><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD>FK, UQ</TD><TD ALIGN="LEFT" PORT="member_id">member_id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD>FK, UQ</TD><TD ALIGN="LEFT" PORT="session_id">training_session_id</TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">attendance_status</TD><TD ALIGN="LEFT">enum</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT">timestamp</TD></TR>
    </TABLE>>];

  // 1 (induk) -- N (anak). Garis keluar dari sisi kanan induk dan masuk ke sisi kiri anak.
  members:id:e           -> memberships:member_id:w           [headlabel="N", taillabel="1", label="memiliki"];
  membership_plans:id:e  -> memberships:plan_id:w             [headlabel="N", taillabel="1", label="dipakai oleh"];
  trainers:id:e          -> training_sessions:trainer_id:w    [headlabel="N", taillabel="1", label="menangani"];
  training_sessions:id:e -> session_participants:session_id:w [headlabel="N", taillabel="1", label="memiliki"];
  members:id:e           -> session_participants:member_id:w  [headlabel="N", taillabel="1", label="mengikuti"];

  legend [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
      <TR><TD ALIGN="LEFT"><B>Keterangan:</B> PK = Primary Key, FK = Foreign Key (ON DELETE RESTRICT), UQ = Unique</TD></TR>
      <TR><TD ALIGN="LEFT">1 ke N = satu data induk memiliki banyak data anak. session_participants adalah tabel penghubung members dan training_sessions.</TD></TR>
    </TABLE>>, fontsize=10];
}
